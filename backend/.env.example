# DischargeAI backend. Copy to .env and edit. Placeholders only; never commit a real .env.
# With nothing set the app runs fully local: SQLite, the SQL twin of the document store, the local
# PDF and audio folders, offline AI providers, the console email transport. With AWS credentials in the shell
# (or an instance role) it reads hackhealth/secret at boot and switches to RDS + DynamoDB + S3.

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Where the patient app lives; links look like ${PATIENT_APP_URL}/s/<sumId>
PATIENT_APP_URL=http://localhost:5173
# Provider endpoints (/patients, /ingest, /jobs, /synthesize) require header x-provider-key: <PROVIDER_API_KEY>
PROVIDER_API_KEY=dev-provider-key
# Pin the app clock to a moment (ISO-8601) for a demo of day 30; leave empty in production.
DEMO_NOW=
# Purge job interval (ms). 0 disables the timer (reads still enforce expiry; npm run sweep runs it once).
PURGE_INTERVAL_MS=60000
MAX_UPLOAD_BYTES=15728640

# Configuration from AWS Secrets Manager (team secret hackhealth/secret). auto reads it at boot when
# credentials resolve; off never calls AWS. Keys: mysql-host, mysql-port, mysql-user, mysql-password,
# mysql-db, dynamodb-table, dynamodb-table-pk. Any variable set below wins over the secret.
SECRETS_BOOTSTRAP=auto
AWS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:183815333909:secret:hackhealth/secret-ZWa02Q
AWS_REGION=us-west-2
# AWS credentials come from the standard chain (shell env, profile, instance role). Never put them here.

# SQL: patients, activeLinks, jobs, audit log. SQLite file by default; MariaDB on RDS in the team account.
#   DATABASE_URL=sqlite:data/app.db
#   DATABASE_URL=mysql://admin:<password>@patients.cleqcmkoulma.us-west-2.rds.amazonaws.com:3306/dischargeai
# Leave DATABASE_URL empty to use MYSQL_* (filled from the secret) when present, else DATABASE_FILE.
DATABASE_FILE=data/app.db
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=dischargeai
MYSQL_POOL_SIZE=5
# AWS connection step 1 downloads this bundle: npm run fetch-rds-bundle
RDS_CA_BUNDLE=certs/global-bundle.pem

# Summary store: one item per summary (uid = sumId, sum-id, raw-text, llm-summary, translations), TTL on expiresAt.
# auto = DynamoDB when the secret resolved, else the SQL twin; or force local | dynamo.
DOC_STORE=auto
DYNAMO_TABLE=discharge-summaries
DYNAMO_PK=uid
# DynamoDB Local (docker compose up): http://localhost:8000. Leave empty for real AWS.
DYNAMO_ENDPOINT=

# PDFs from POST /ingest type pdf: auto = the S3 bucket when the secret resolved (falls back to the local
# folder if the bucket is unreachable; see /health), or force local | s3. npm run setup-s3 creates it.
PDF_STORE=auto
PDF_BUCKET=emrpdf-rh
PDF_DIR=data/pdf

# Audio clips: auto = the S3 bucket when the secret resolved (falls back to the local folder if the
# bucket is unreachable; see /health), or force local | s3. The bucket keeps the 30-day lifecycle rule.
AUDIO_STORE=auto
AUDIO_BUCKET=emraudio-rh
AUDIO_DIR=data/audio

# Deletion receipts: sql (audit_log table, default) | file (AUDIT_FILE) | console | dynamo (receipt# items in the table)
AUDIT_SINK=sql
AUDIT_FILE=data/audit/receipts.jsonl

# LLM provider for the simplifier and translator: offline | bedrock | anthropic
# offline needs no keys and runs the whole demo and the test suite.
# bedrock is the live provider (Amazon Bedrock Converse). Verified model ids in the hackathon account:
#   us.anthropic.claude-sonnet-4-6 (default) and us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_PROVIDER=offline
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Direct Anthropic API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Speech to text for dictated audio: offline (fixture transcript) | transcribe (Amazon Transcribe Medical over the audio bucket)
SPEECH_PROVIDER=offline
# Transcribe writes transcripts/<job>.json here; defaults to AUDIO_BUCKET (same 30-day lifecycle)
TRANSCRIBE_OUTPUT_BUCKET=

# Email: console (prints the message) | smtp (SMTP_URL) | ses (Amazon SES v2)
EMAIL_TRANSPORT=console
EMAIL_FROM=DischargeAI <noreply@example.test>
SMTP_URL=
# Queue instead of sending inline: none | sqs (scripts/email-worker.ts consumes SQS_QUEUE_URL)
EMAIL_QUEUE=none
SQS_QUEUE_URL=
