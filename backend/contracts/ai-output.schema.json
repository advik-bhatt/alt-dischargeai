{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sameerj05/DischargeAI/backend/contracts/ai-output.schema.json",
  "title": "DischargeAI AI output (per language)",
  "description": "Lane 3 contract: raw clinician text in, this JSON out, once per language. Top-level keys are exactly language, steps, medications, followUps, warnings.",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP-47 code of the text, e.g. en, es, zh, ar"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable short id, e.g. step-1"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "One thing the patient does, at a 5th-grade reading level"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Drug name exactly as written in the source"
          },
          "dose": {
            "type": "string",
            "description": "Dose exactly as written in the source, e.g. '40 mg'. Empty string when the source gives none."
          },
          "howOften": {
            "type": "string",
            "description": "How often and how to take it, in plain words; every number copied from the source"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "continue",
              "stop"
            ],
            "description": "new = start it, continue = keep taking it, stop = stopped or on hold"
          },
          "why": {
            "type": "string",
            "description": "Why, in plain words"
          }
        },
        "required": [
          "name",
          "dose",
          "howOften",
          "status",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "minLength": 1,
            "description": "Who to see, e.g. 'Primary care doctor'"
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "description": "When, in plain words, e.g. 'within 1 week'"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Why, in plain words"
          }
        },
        "required": [
          "who",
          "when",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "A warning sign, in plain words"
          },
          "tier": {
            "description": "call911 = life-threatening, er = same-day care, clinic = call the care team",
            "type": "string",
            "enum": [
              "call911",
              "er",
              "clinic"
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "language",
    "steps",
    "medications",
    "followUps",
    "warnings"
  ],
  "additionalProperties": false
}
